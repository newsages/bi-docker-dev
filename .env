##########################################
### ZooKeeper
ZOO_UID=1000
ZOO_GID=1000
ZOO_HOME_DIR=/opt/zookeeper
ZOO_HOSTNAME_1=zk1
ZOO_HOSTNAME_2=zk2
ZOO_HOSTNAME_3=zk3
#ZOO_SERVERS=server.1=$ZOO_HOSTNAME_1:2888:3888;2181 server.2=$ZOO_HOSTNAME_2:2888:3888;2181 server.3=$ZOO_HOSTNAME_3:2888:3888;2181

##########################################
### NIFI 
NIFI_HOSTNAME=eco-nifi
NIFI_VERSION=1.9.2

NIFI_BASE_DIR=/opt/nifi
#NIFI_HOME=${NIFI_BASE_DIR}/nifi-current
#NIFI_LOG_DIR=${NIFI_HOME}/logs
#NIFI_TOOLKIT_HOME=${NIFI_BASE_DIR}/nifi-toolkit-current

NIFI_WEB_HTTP_PORT=8080
NIFI_WEB_HTTP_PORT_EXTERNAL=30100

NIFI_WEB_HTTPS_PORT=8443
NIFI_WEB_HTTPS_PORT_EXTERNAL=30110

NIFI_REMOTE_INPUT_SOCKET_PORT=10000
NIFI_REMOTE_INPUT_SOCKET_PORT_EXTERNAL=30120

NIFI_CLUSTER_NODE_PROTOCOL_PORT=8082
NIFI_CLUSTER_NODE_PROTOCOL_PORT_EXTERNAL=30130

NIFI_CLUSTER_IS_NODE=true
#NIFI_ZK_CONNECT_STRING=$ZOO_HOSTNAME_1:2181,$ZOO_HOSTNAME_2:2181,$ZOO_HOSTNAME_3:2181
NIFI_ZK_ROOT_NODE=/nifi
NIFI_ELECTION_MAX_WAIT=1 min

###################################3




POSTGRES_DB=superset
POSTGRES_PASSWORD=superset
POSTGRES_USER=superset
POSTGRES_HOST=eco-postgres
POSTGRES_PORT=5432

REDIS_HOST=eco-redis
REDIS_PORT=6379

# If using production, comment development volume below
SUPERSET_HOST=eco-superset
#SUPERSET_ENV=production
SUPERSET_ENV=development
